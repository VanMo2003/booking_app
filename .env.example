# Optional overrides for docker-compose defaults.
# You can run without this file. Create .env only when you want to customize.

# App runtime
PORT=8080
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Internal MySQL service in docker-compose
MYSQL_DATABASE=booking_app_db
MYSQL_USER=booking_user
MYSQL_PASSWORD=booking_password
MYSQL_ROOT_PASSWORD=root_password
SPRING_DATASOURCE_URL=jdbc:mysql://booking-db:3306/booking_app_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh
SPRING_DATASOURCE_USERNAME=booking_user
SPRING_DATASOURCE_PASSWORD=booking_password

# Security
JWT_SIGNER_KEY=please_change_this_jwt_signer_key_in_production

# VNPay
VNPAY_TMN_CODE=KUHZ6TQJ
VNPAY_SECRET_KEY=K20SB7Q7577Q70YWF5I512BL3IX95TP4
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost/booking-app/api/v1/payment/vn-pay-callback

# Email kết quả xét duyệt chủ khách sạn (để trống MAIL_USERNAME thì chỉ ghi log)
# Gmail: bật xác minh 2 bước rồi tạo App Password, dán 16 ký tự vào MAIL_PASSWORD
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# Địa chỉ API mà điện thoại mở được — nút "Mở ứng dụng" trong email trỏ tới {APP_PUBLIC_URL}/app-links/...
APP_PUBLIC_URL=http://localhost/booking-app/api/v1

# Thông báo đẩy FCM: đường dẫn (bên trong container) tới file JSON service account của Firebase.
# Để trống thì chỉ có thông báo trong app. Xem README mục "Email và thông báo đẩy".
FIREBASE_CREDENTIALS=

# Tính năng AI (trợ lý lễ tân trong chat, tìm kiếm bằng câu nói). Để trống key thì AI tắt.
ANTHROPIC_API_KEY=
AI_ASSISTANT_MODEL=claude-sonnet-5
AI_FAST_MODEL=claude-haiku-4-5-20251001
AI_AUTO_REPLY_DELAY_SECONDS=90
